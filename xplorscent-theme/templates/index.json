        },
        "longevity": {
          "type": "column",
          "settings": {
            "icon": "shield",
            "title": "Lasting wear",
            "text": "<p>High-concentration eaux de parfum designed to stay with you all day.</p>"
          }
        },
        "award": {
          "type": "column",
          "settings": {
            "icon": "star",

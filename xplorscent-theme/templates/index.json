    "story": {
      "type": "image-with-text",
      "blocks": {
        "eyebrow": { "type": "eyebrow", "settings": { "text": "Our story" } },
        "heading": { "type": "heading", "settings": { "heading": "Two traditions, one signature" } },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>XplorScent was born where French perfumery meets the depth of Arabian oud. Every composition is crafted in Dubai with a simple belief: fine fragrance should be an everyday pleasure, not a rare occasion.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": { "button_label": "Read our story", "button_link": "shopify://pages/about", "style": "link" }
        }

    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long do your fragrances last?",
            "answer": "<p>Our eaux de parfum are composed at a high concentration for long wear — up to 12 hours depending on the scent and your skin type. Apply to pulse points and moisturized skin for best results.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Are your fragrances unisex?",
            "answer": "<p>Yes — every XplorScent composition is designed to be worn by anyone. We build scents around character and mood, not categories.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What is the Discovery Set?",
            "answer": "<p>Five 3&nbsp;mL miniatures of our signature fragrances — the perfect low-risk way to find your scent before committing to a full bottle.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Where do you ship?",
            "answer": "<p>We ship worldwide with tracked delivery. Orders are dispatched within 1–2 business days.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4"],

            "title": "Crafted in Dubai",
            "text": "<p>Composed with rare oud and fine French ingredients, bottled with care.</p>"
          }
        },
        "unisex": {
          "type": "column",
          "settings": {
            "icon": "leaf",
            "title": "Unisex by design",
            "text": "<p>Scents built around character, not category — made for everyone.</p>"

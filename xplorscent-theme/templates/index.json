    "fragrance_story": {
      "type": "fragrance-story",
      "blocks": {
        "opening": {
          "type": "chapter",
          "settings": {
            "label": "The opening",
            "heading": "It begins in light",
            "text": "<p>The first breath — bright bergamot and citrus lift off the skin in the opening minutes, setting the tone for everything beneath.</p>",
            "notes": "Bergamot, Lemon, Mandarin",
            "mood": "citrus"
          }
        },
        "heart": {
          "type": "chapter",
          "settings": {
            "label": "The heart",
            "heading": "Then it blooms",
            "text": "<p>As the light settles, the heart emerges — florals, spice and herbs weaving the character you'll be remembered by.</p>",
            "notes": "Jasmine, Black pepper, Lavender",
            "mood": "floral"
          }
        },
        "trail": {
          "type": "chapter",
          "settings": {
            "label": "The trail",
            "heading": "And it stays",
            "text": "<p>Hours later, the base remains: oud, amber and sandalwood — the trail that lingers in a room after you've left it.</p>",
            "notes": "Oud, Amber, Sandalwood",
            "mood": "oud"
          }
        }
      },
      "block_order": ["opening", "heart", "trail"],
      "settings": {
        "eyebrow": "Anatomy of a scent",
        "heading": "How an XplorScent unfolds",
        "subheading": "Every composition is a journey in three movements.",
        "cta_label": "Begin with the Discovery Set",
        "background": "surface"
      }
    },

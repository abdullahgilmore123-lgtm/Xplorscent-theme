{
  "sections": {
    "banner": {
      "type": "collection-banner",
      "settings": { "show_image": true, "show_description": true }
    },
    "product_grid": {
      "type": "main-collection",
      "settings": {
        "products_per_page": 16,
        "enable_filtering": true,
        "enable_sorting": true
      }
    },
    "layering": {
      "type": "image-with-text",
      "blocks": {
        "eyebrow": { "type": "eyebrow", "settings": { "text": "The art of layering" } },
        "heading": { "type": "heading", "settings": { "heading": "Lighter by design" } },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Each hair &amp; body mist carries its signature at an airy concentration — gentle enough for hair, made to be reapplied through the day. Wear it alone, or layer it over the matching eau de parfum to extend the story.</p>"
          }
        }
      },
      "block_order": ["eyebrow", "heading", "text"],
      "settings": { "image_ratio": "square", "layout": "text_first", "background": "surface" }
    },
    "recently_viewed": {
      "type": "recently-viewed",
      "settings": { "heading": "Recently viewed", "products_to_show": 4 }
    }
  },
  "order": ["banner", "product_grid", "layering", "recently_viewed"]
}

{% comment %}
  Signature fragrance discovery section: scent-family cards routing shoppers
  into curated collections, with an optional Discovery Set callout.
{% endcomment %}

<section class="section">
  <div class="container">
    <div class="section__header section__header--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="grid scent-finder reveal" style="--scent-finder-cols: {{ section.blocks.size | at_most: 4 | at_least: 2 }};" role="list">
      {%- for block in section.blocks -%}
        <a
          href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          class="scent-card"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <div class="media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.image.alt
              }}
            {%- endif -%}
          </div>
          <div class="scent-card__content">
            <h3 class="h4">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.notes != blank -%}
              <p class="scent-card__note">{{ block.settings.notes | escape }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="text-align: center; margin-top: 4.8rem;" class="reveal">
        {%- if section.settings.cta_text != blank -%}
          <p class="section__subheading" style="margin-bottom: 1.6rem;">{{ section.settings.cta_text | escape }}</p>
        {%- endif -%}
        <a href="{{ section.settings.cta_link }}" class="button">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Scent finder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find yours"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which scent are you?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every XplorScent composition belongs to a family. Start with the mood you love."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Callout text",
      "default": "Can't decide? Try all five signatures in miniature."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Callout button label",
      "default": "Shop the Discovery Set"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Callout button link"
    }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Scent family",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Family name",
          "default": "Oud & Woody"
        },
        {
          "type": "text",
          "id": "notes",
          "label": "Signature notes",
          "default": "Oud wood · Black pepper"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 800 x 1060px (3:4)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Usually a collection filtered to this family."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Scent finder",
      "blocks": [
        { "type": "family" },
        { "type": "family", "settings": { "title": "Floral", "notes": "Jasmine · Sandalwood" } },
        { "type": "family", "settings": { "title": "Fresh & Citrus", "notes": "Bergamot · Apple" } },
        { "type": "family", "settings": { "title": "Oriental", "notes": "Vanilla · Amber" } }
      ]
    }
  ]
}
{% endschema %}

<section class="section">
  <div class="container">
    <div class="section__header">
      <h1>{{ 'sections.cart.title' | t }}</h1>
    </div>

    {%- if cart == empty -%}
      <div class="collection-empty">
        <h2>{{ 'sections.cart.empty' | t }}</h2>
        <p class="section__subheading">{{ 'sections.cart.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page">
        <div class="cart-page__items">
          {%- for item in cart.items -%}
            <div class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '100px', loading: 'lazy', alt: item.image.alt }}
                {%- else -%}
                  {% render 'brand-visual', kind: 'bottle', index: item.product_id %}
                {%- endif -%}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant caption">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                {%- if item.original_line_price != item.final_line_price -%}
                  <s class="caption">{{ item.original_line_price | money }}</s>
                {%- endif -%}
                <div class="cart-item__controls">
                  <label class="visually-hidden" for="CartQuantity-{{ forloop.index }}">
                    {{ 'products.product.quantity.label' | t }}
                  </label>
                  <quantity-input class="quantity">
                    <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
                      {% render 'icon', icon: 'minus', size: 14 %}
                    </button>
                    <input
                      class="quantity__input"
                      type="number"
                      id="CartQuantity-{{ forloop.index }}"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      inputmode="numeric"
                      aria-label="{{ 'products.product.quantity.label' | t }}"
                    >
                    <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
                      {% render 'icon', icon: 'plus', size: 14 %}
                    </button>
                  </quantity-input>
                  <a
                    href="{{ item.url_to_remove }}"
                    class="cart-item__remove icon-button"
                    aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                  >
                    {% render 'icon', icon: 'trash', size: 16 %}
                  </a>
                </div>
              </div>
              <div class="cart-item__price">
                <span>{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {%- endfor -%}

          <button type="submit" name="update" class="button button--secondary button--small" style="margin-top: 2rem;">
            {{ 'sections.cart.update' | t }}
          </button>
        </div>

        <aside class="cart-page__summary" aria-label="{{ 'sections.cart.summary' | t }}">
          {%- if section.settings.show_shipping_bar and section.settings.shipping_bar_threshold > 0 -%}
            {%- liquid
              assign threshold = section.settings.shipping_bar_threshold | times: 100
              assign remaining = threshold | minus: cart.total_price
              assign remaining_money = remaining | money
              assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
            -%}
            <div aria-live="polite">
              {%- if remaining > 0 -%}
                <p class="caption">{{ 'sections.cart.shipping_bar.remaining_html' | t: amount: remaining_money }}</p>
              {%- else -%}
                <p class="caption cart-drawer__shipping-unlocked">
                  {% render 'icon', icon: 'check', size: 14 %}
                  {{ 'sections.cart.shipping_bar.unlocked' | t }}
                </p>
              {%- endif -%}
              <div class="progress-bar" role="progressbar" aria-valuenow="{{ progress | round }}" aria-valuemin="0" aria-valuemax="100">
                <span class="progress-bar__fill" style="width: {{ progress }}%"></span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_note -%}
            <details class="cart-drawer__note">
              <summary class="caption">{{ 'sections.cart.note' | t }}</summary>
              <textarea name="note" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          <div class="cart-drawer__subtotal">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="caption">
            {%- if cart.taxes_included -%}
              {{ 'sections.cart.taxes_included' | t }}
            {%- else -%}
              {{ 'sections.cart.taxes_at_checkout' | t }}
            {%- endif -%}
          </p>
          <button type="submit" name="checkout" class="button button--full">
            {{ 'sections.cart.checkout' | t }}
          </button>

          <div class="cart-page__trust">
            <span class="product__trust-item">
              {% render 'icon', icon: 'shield', size: 16 %}
              {{ 'sections.cart.secure_checkout' | t }}
            </span>
            <span class="product__trust-item">
              {% render 'icon', icon: 'truck', size: 16 %}
              {{ 'sections.cart.tracked_shipping' | t }}
            </span>
          </div>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_bar",
      "label": "Show free shipping progress bar",
      "default": true
    },
    {
      "type": "range",
      "id": "shipping_bar_threshold",
      "label": "Free shipping threshold",
      "info": "In your store currency. Keep in sync with the cart drawer setting.",
      "min": 0,
      "max": 300,
      "step": 5,
      "default": 75
    }
  ]
}
{% endschema %}

<div class="password-content">
  <h1 class="header__logo-text">{{ shop.name }}</h1>
  {%- if section.settings.heading != blank -%}
    <h2 class="h3">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if shop.password_message != blank -%}
    <p class="section__subheading">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="form__message form__message--success" role="status">{{ 'general.newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter__field">
        <input
          type="email"
          name="contact[email]"
          class="newsletter__input"
          placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
          aria-label="{{ 'general.newsletter.email_placeholder' | t }}"
          required
        >
        <button type="submit" class="newsletter__submit">{{ 'general.newsletter.submit' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top: 2rem;">
    <summary class="caption">{{ 'general.password_page.login_password_button' | t }}</summary>
    {%- form 'storefront_password', style: 'margin-top: 1.6rem;' -%}
      <div class="newsletter__field">
        <input
          type="password"
          name="password"
          class="newsletter__input"
          placeholder="{{ 'general.password_page.password_placeholder' | t }}"
          aria-label="{{ 'general.password_page.password_placeholder' | t }}"
        >
        <button type="submit" class="newsletter__submit">{{ 'general.password_page.enter' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p class="form__message form__message--error" role="alert">{{ 'general.password_page.wrong_password' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something beautiful is coming"
    }
  ]
}
{% endschema %}

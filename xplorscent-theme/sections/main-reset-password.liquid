<section class="section">
  <div class="container customer">
    <div class="customer__header">
      <h1>{{ 'customer.reset_password.title' | t }}</h1>
      <p class="section__subheading">{{ 'customer.reset_password.subtext' | t }}</p>
    </div>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error" role="alert">
          {% render 'icon', icon: 'error', size: 16 %}
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input class="field__input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input class="field__input" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <div class="form__actions">
        <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}

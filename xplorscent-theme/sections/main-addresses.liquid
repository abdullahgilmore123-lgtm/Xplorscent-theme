<section class="section">
  <div class="container customer customer--wide">
    <div class="customer__header">
      <h1>{{ 'customer.addresses.title' | t }}</h1>
      <a href="{{ routes.account_url }}" class="link">{{ 'customer.account.return' | t }}</a>
    </div>

    <div style="text-align: center; margin-bottom: 3.2rem;">
      <button type="button" class="button" onclick="document.getElementById('AddAddress').toggleAttribute('hidden'); this.setAttribute('aria-expanded', document.getElementById('AddAddress').hidden ? 'false' : 'true');" aria-expanded="false" aria-controls="AddAddress">
        {{ 'customer.addresses.add_new' | t }}
      </button>
    </div>

    <div id="AddAddress" hidden style="max-width: 52rem; margin: 0 auto 4.8rem;">
      <h2 class="h4" style="margin-bottom: 2rem;">{{ 'customer.addresses.add_new' | t }}</h2>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-form-fields', form: form %}
        <div class="form__actions">
          <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
        </div>
      {%- endform -%}
    </div>

    <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));">
      {%- paginate customer.addresses by 6 -%}
        {%- for address in customer.addresses -%}
          <div class="address-card">
            {%- if address == customer.default_address -%}
              <p class="caption">{{ 'customer.addresses.default' | t }}</p>
            {%- endif -%}
            {{ address | format_address }}
            <div class="address-card__actions">
              <button
                type="button"
                class="link"
                onclick="document.getElementById('EditAddress-{{ address.id }}').toggleAttribute('hidden');"
                aria-expanded="false"
                aria-controls="EditAddress-{{ address.id }}"
              >
                {{ 'customer.addresses.edit' | t }}
              </button>
              {%- form 'customer_address', address -%}
                <button
                  type="submit"
                  class="link"
                  name="_method"
                  value="delete"
                  onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t | escape }}');"
                >
                  {{ 'customer.addresses.delete' | t }}
                </button>
              {%- endform -%}
            </div>
            <div id="EditAddress-{{ address.id }}" hidden style="margin-top: 2rem;">
              {%- form 'customer_address', address -%}
                {% render 'address-form-fields', form: form %}
                <label class="facets__item" style="margin-top: 1.2rem;">
                  <input type="checkbox" name="address[default]" {% if address == customer.default_address %}checked{% endif %}>
                  <span>{{ 'customer.addresses.set_default' | t }}</span>
                </label>
                <div class="form__actions">
                  <button type="submit" class="button button--small">{{ 'customer.addresses.update' | t }}</button>
                </div>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Addresses",
  "settings": []
}
{% endschema %}

{%- liquid
  assign height_class = 'hero--large'
  if section.settings.height == 'small'
    assign height_class = 'hero--small'
  elsif section.settings.height == 'medium'
    assign height_class = 'hero--medium'
  endif

  assign content_class = ''
  if section.settings.content_position == 'center'
    assign content_class = 'hero__content--center'
  elsif section.settings.content_position == 'middle-left'
    assign content_class = 'hero__content--middle-left'
  endif
-%}

<section class="hero {{ height_class }} hero--inverse" style="--hero-overlay: {{ section.settings.overlay_opacity }};">
  <div
    class="hero__media{% if section.settings.motion == 'kenburns' %} hero__media--kenburns{% endif %}"
    {% if section.settings.motion == 'parallax' %}data-parallax="0.4"{% endif %}
  >
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1900, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {% render 'brand-visual', kind: 'hero', loading: 'eager' %}
    {%- endif -%}
  </div>

  <div class="hero__content container {{ content_class }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          <h2
            class="hero__heading {% if block.settings.size == 'display' %}hero__heading--display{% else %}{{ block.settings.size }}{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.heading | escape -}}
            {%- if block.settings.heading_accent != blank -%}
              <em class="hero__heading-accent">{{ block.settings.heading_accent | escape }}</em>
            {%- endif -%}
          </h2>
        {%- when 'text' -%}
          <p class="hero__text" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'buttons' -%}
          <div class="hero__buttons" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              <a href="{{ block.settings.button_link_2 }}" class="button button--secondary">{{ block.settings.button_label_2 | escape }}</a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <div class="hero__scroll-cue" aria-hidden="true">{{ 'general.scroll' | t }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended: 2400 x 1350px (16:9) or larger. The focal point should sit in the lower two thirds."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Image motion",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "kenburns", "label": "Slow cinematic zoom" },
        { "value": "parallax", "label": "Subtle parallax" }
      ],
      "default": "kenburns",
      "info": "Automatically disabled for visitors who prefer reduced motion."
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Show scroll cue",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Crafted in Dubai"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fragrance, made to be explored"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Heading size",
          "options": [
            { "value": "h1", "label": "Large" },
            { "value": "h0", "label": "Extra large" },
            { "value": "display", "label": "Display (cinematic)" }
          ],
          "default": "h0"
        },
        {
          "type": "text",
          "id": "heading_accent",
          "label": "Italic accent line",
          "info": "Rendered on its own line in italic serif."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "French artistry. Arabian oud. Unisex eaux de parfum composed for the curious."
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "First button label",
          "default": "Shop fragrances"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "First button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Second button label",
          "default": "Try the Discovery Set"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}

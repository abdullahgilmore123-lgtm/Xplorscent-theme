{% comment %}
  Instagram gallery. Images are managed in the theme editor (no API keys, no
  third-party scripts). Each tile can link to the matching post; the heading
  links to the profile. Apps that provide a live feed can be added as an app
  block on any template instead.
{% endcomment %}

<section class="section">
  <div class="container">
    <div class="section__header section__header--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>
          {%- if section.settings.profile_url != blank -%}
            <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener" style="text-decoration: none; color: inherit;">
              {{ section.settings.heading | escape }}
            </a>
          {%- else -%}
            {{ section.settings.heading | escape }}
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="grid instagram-grid reveal" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_url = block.settings.link
          if tile_url == blank
            assign tile_url = section.settings.profile_url
          endif
        -%}
        <a
          {% if tile_url != blank %}href="{{ tile_url }}" target="_blank" rel="noopener"{% endif %}
          class="instagram-grid__item media media--square"
          role="listitem"
          {% if tile_url != blank %}aria-label="{{ 'sections.instagram.view_post' | t }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 16vw, (min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: block.settings.image.alt
            }}
          {%- else -%}
            <div class="media__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
          <span class="instagram-grid__overlay">
            {% render 'icon', icon: 'instagram', size: 22 %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@xplorscent"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Follow the exploration"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Instagram profile URL"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 800 x 800px. Use your own photography or posts you have rights to."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post link",
          "info": "Leave blank to link to the profile."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}

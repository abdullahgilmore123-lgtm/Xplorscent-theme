<section class="section">
  <div class="container">
    <div class="error-404">
      <p class="error-404__code" aria-hidden="true">404</p>
      <h1>{{ 'templates.404.title' | t }}</h1>
      <p class="section__subheading">{{ 'templates.404.subtext' | t }}</p>
      <div class="hero__buttons">
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'templates.404.shop_all' | t }}</a>
        <a href="{{ routes.root_url }}" class="button button--secondary">{{ 'templates.404.go_home' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}

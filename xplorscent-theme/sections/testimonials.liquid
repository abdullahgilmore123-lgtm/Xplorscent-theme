<section class="section{% if section.settings.background == 'surface' %} color-surface{% endif %}">
  <div class="container">
    <div class="section__header section__header--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="grid testimonials reveal" role="list">
      {%- for block in section.blocks -%}
        <blockquote class="testimonial" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.stars > 0 -%}
            <span class="rating__stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.stars, rating_max: 5 }}">
              {%- for i in (1..block.settings.stars) -%}
                {% render 'icon', icon: 'star-filled', size: 14 %}
              {%- endfor -%}
            </span>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <p class="testimonial__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
          {%- endif -%}
          <footer class="testimonial__author">
            {%- if block.settings.author != blank -%}
              <cite class="testimonial__name">{{ block.settings.author | escape }}</cite>
            {%- endif -%}
            {%- if block.settings.detail != blank -%}
              <span class="caption">{{ block.settings.detail | escape }}</span>
            {%- endif -%}
          </footer>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn and loved"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft beige" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The One is unlike anything on my shelf — deep, warm and it lasts all day. I get asked about it constantly."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "e.g. Verified buyer, product name",
          "default": "Verified buyer — The One"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}

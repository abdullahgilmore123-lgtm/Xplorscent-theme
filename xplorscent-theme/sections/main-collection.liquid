<section class="section" style="padding-top: 0;">
  <div class="container">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% render 'facets', results: collection, results_url: collection.url %}
      {%- endif -%}

      <p class="collection-toolbar__count visually-hidden" role="status">
        {{ 'products.facets.product_count' | t: count: collection.products_count }}
      </p>

      {%- if collection.products.size == 0 -%}
        <div class="collection-empty">
          <h2>{{ 'sections.collection_template.empty' | t }}</h2>
          <p class="section__subheading">{{ 'sections.collection_template.use_fewer_filters' | t }}</p>
          <a href="{{ collection.url }}" class="button button--secondary">{{ 'products.facets.clear_all' | t }}</a>
        </div>
      {%- else -%}
        <div class="product-grid product-grid--4" role="list">
          {%- for product in collection.products -%}
            <div role="listitem">
              {%- liquid
                assign lazy = true
                if forloop.index <= 4 and paginate.current_page == 1
                  assign lazy = false
                endif
              -%}
              {% render 'product-card', card_product: product, section_id: section.id, lazy_load: lazy %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true,
      "info": "Customize filters in the Shopify Search & Discovery app."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    }
  ]
}
{% endschema %}

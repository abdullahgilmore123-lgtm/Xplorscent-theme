<section class="section{% if section.settings.background == 'surface' %} color-surface{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section__header{% if section.settings.center_content %} section__header--center{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid multicolumn reveal" style="--multicolumn-cols: {{ section.settings.columns_desktop }};" role="list">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item{% if section.settings.center_content %} multicolumn__item--center{% endif %}" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media media--landscape">
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt
              }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="multicolumn__icon">
              {% render 'icon', icon: block.settings.icon, size: 24 %}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="h5">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="multicolumn__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why XplorScent"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "center_content",
      "label": "Center content",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft beige" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Recommended: 800 x 530px. Overrides the icon."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "truck", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "check", "label": "Check" }
          ],
          "default": "droplet"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Crafted in Dubai"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Composed with rare oud and fine French ingredients, bottled with care.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

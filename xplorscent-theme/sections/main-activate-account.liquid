<section class="section">
  <div class="container customer">
    <div class="customer__header">
      <h1>{{ 'customer.activate_account.title' | t }}</h1>
      <p class="section__subheading">{{ 'customer.activate_account.subtext' | t }}</p>
    </div>

    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error" role="alert">
          {% render 'icon', icon: 'error', size: 16 %}
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ActivatePassword">{{ 'customer.login_page.password' | t }}</label>
        <input class="field__input" type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input class="field__input" type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <div class="form__actions" style="display: flex; gap: 1.2rem;">
        <button type="submit" class="button">{{ 'customer.activate_account.submit' | t }}</button>
        <button type="submit" class="button button--secondary" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Activate account",
  "settings": []
}
{% endschema %}

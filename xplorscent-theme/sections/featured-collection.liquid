{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<section class="section{% if section.settings.background == 'surface' %} color-surface{% endif %}">
  <div class="container">
    <div class="section__header{% if section.settings.center_heading %} section__header--center{% endif %} reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="product-grid product-grid--4{% if section.settings.enable_mobile_scroll %} product-grid--scroll{% endif %} reveal" role="list">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          <div role="listitem">
            {% render 'product-card', card_product: product, section_id: section.id %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div role="listitem">
            <article class="product-card">
              <div class="product-card__media media media--portrait">
                {% render 'brand-visual', kind: 'bottle', index: forloop.index0 %}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
                <div class="price"><span class="price__regular">{{ 1999 | money }}</span></div>
              </div>
            </article>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="margin-top: 4rem; text-align: center;">
        <a href="{{ collection.url }}" class="link">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', icon: 'arrow-right', size: 16 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center heading",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_scroll",
      "label": "Horizontal scroll on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft beige" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}

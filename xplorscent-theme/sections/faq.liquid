<section class="section">
  <div class="container">
    <div class="section__header section__header--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="faq reveal">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}{% if section.settings.open_first and forloop.first %} open{% endif %}>
          <summary class="faq__question">
            {{ block.settings.question | escape }}
            {% render 'icon', icon: 'plus', size: 18 %}
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_contact_link -%}
      <div style="text-align: center; margin-top: 4rem;" class="reveal">
        <p class="section__subheading" style="margin-bottom: 1.6rem;">{{ 'sections.faq.more_questions' | t }}</p>
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="link">
          {{ 'sections.faq.contact_us' | t }}
          {% render 'icon', icon: 'arrow-right', size: 16 %}
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.enable_schema -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_contact_link",
      "label": "Show contact link",
      "default": true
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Enable FAQ structured data (SEO)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long do your fragrances last?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our eaux de parfum are composed at a high concentration for 8+ hours of wear. Longevity varies with skin type — apply to pulse points and moisturized skin for best results.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}

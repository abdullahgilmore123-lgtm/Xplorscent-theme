<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__logo">{{ shop.name }}</span>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          <div class="footer__social">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="icon-button" target="_blank" rel="noopener" aria-label="Instagram">
                {% render 'icon', icon: 'instagram', size: 18 %}
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" class="icon-button" target="_blank" rel="noopener" aria-label="TikTok">
                {% render 'icon', icon: 'tiktok', size: 18 %}
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" class="icon-button" target="_blank" rel="noopener" aria-label="Facebook">
                {% render 'icon', icon: 'facebook', size: 18 %}
              </a>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <a href="{{ settings.social_twitter_link }}" class="icon-button" target="_blank" rel="noopener" aria-label="X (Twitter)">
                {% render 'icon', icon: 'twitter', size: 18 %}
              </a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a href="{{ settings.social_youtube_link }}" class="icon-button" target="_blank" rel="noopener" aria-label="YouTube">
                {% render 'icon', icon: 'youtube', size: 18 %}
              </a>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" class="icon-button" target="_blank" rel="noopener" aria-label="Pinterest">
                {% render 'icon', icon: 'pinterest', size: 18 %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <nav {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | escape }}">
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__menu">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>
          {%- when 'newsletter' -%}
            <div class="footer__newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="footer__tagline">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'newsletter__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.errors -%}
                  <p class="form__message form__message--error" role="alert">
                    {% render 'icon', icon: 'error', size: 16 %}
                    {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
                  </p>
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                  <p class="form__message form__message--success" role="status">
                    {% render 'icon', icon: 'success', size: 16 %}
                    {{ 'general.newsletter.success' | t }}
                  </p>
                {%- else -%}
                  <div class="newsletter__field">
                    <input
                      type="email"
                      name="contact[email]"
                      id="FooterNewsletterEmail"
                      class="newsletter__input"
                      value="{{ form.email }}"
                      required
                      autocomplete="email"
                      placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                      aria-label="{{ 'general.newsletter.email_placeholder' | t }}"
                    >
                    <button type="submit" class="newsletter__submit" name="commit">
                      {{ 'general.newsletter.submit' | t }}
                    </button>
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>
        <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</small>
        {%- if section.settings.show_policies -%}
          <ul class="footer__policies">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
        <div class="footer__localization">
          {%- form 'localization', id: 'FooterLocalization' -%}
            {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
              <select name="country_code" aria-label="{{ 'general.localization.country_label' | t }}" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
              <select name="locale_code" aria-label="{{ 'general.localization.language_label' | t }}" onchange="this.form.submit()">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment" role="list" aria-label="{{ 'general.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Where French artistry meets the mystery of Arabian oud. Crafted in Dubai, made to be explored."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Add your social links in Theme settings > Social media."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Join the exploration"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New fragrances, private launches and stories from the atelier. No noise."
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}

<section class="section">
  <div class="container">
    <div class="section__header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="grid collection-list reveal-group reveal-group--alt" style="--collection-list-cols: {{ section.blocks.size | at_most: 4 | at_least: 2 }};" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <a
          href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          class="collection-card"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <div class="media media--landscape">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1100
                | image_tag: widths: '550, 800, 1100', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: block.settings.image.alt
              }}
            {%- elsif collection.featured_image != blank -%}
              {{
                collection.featured_image
                | image_url: width: 1100
                | image_tag: widths: '550, 800, 1100', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: collection.featured_image.alt
              }}
            {%- else -%}
              {% render 'brand-visual', kind: 'wide', index: forloop.index0 %}
            {%- endif -%}
          </div>
          <div class="collection-card__content">
            <h3 class="collection-card__title h4">
              {%- if block.settings.title != blank -%}
                {{ block.settings.title | escape }}
              {%- elsif collection != blank -%}
                {{ collection.title | escape }}
              {%- else -%}
                {{ 'onboarding.collection_title' | t }}
              {%- endif -%}
            </h3>
            {% render 'icon', icon: 'arrow-right', size: 18 %}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Recommended: 1200 x 800px. Leave blank to use the collection image."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

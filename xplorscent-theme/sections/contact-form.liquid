<section class="section">
  <div class="container container--medium">
    <div class="contact">
      <div class="contact__info">
        <div class="section__header" style="margin-bottom: 0;">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
          {%- if section.settings.text != blank -%}
            <p class="section__subheading">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.email != blank -%}
          <div class="contact__info-item">
            {% render 'icon', icon: 'email', size: 20 %}
            <div>
              <p class="caption">{{ 'templates.contact.email_label' | t }}</p>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div class="contact__info-item">
            {% render 'icon', icon: 'phone', size: 20 %}
            <div>
              <p class="caption">{{ 'templates.contact.phone_label' | t }}</p>
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div class="contact__info-item">
            {% render 'icon', icon: 'pin', size: 20 %}
            <div>
              <p class="caption">{{ 'templates.contact.address_label' | t }}</p>
              <p>{{ section.settings.address }}</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success" role="status">
              {% render 'icon', icon: 'success', size: 16 %}
              {{ 'templates.contact.success' | t }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form__message form__message--error" role="alert">
              {% render 'icon', icon: 'error', size: 16 %}
              <div>
                {{ 'templates.contact.error_heading' | t }}
                <ul>
                  {%- for field in form.errors -%}
                    <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}

          <div class="form__row form__row--half">
            <div class="field">
              <label class="field__label" for="ContactName">{{ 'templates.contact.name' | t }}</label>
              <input class="field__input" type="text" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail">{{ 'templates.contact.email' | t }}</label>
              <input class="field__input" type="email" id="ContactEmail" name="contact[email]" autocomplete="email" value="{{ form.email }}" required aria-required="true">
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="ContactSubject">{{ 'templates.contact.subject' | t }}</label>
            <input class="field__input" type="text" id="ContactSubject" name="contact[subject]" value="{{ form.subject }}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactMessage">{{ 'templates.contact.message' | t }}</label>
            <textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <div class="form__actions">
            <button type="submit" class="button">{{ 'templates.contact.send' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're here to help"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A question about a scent, an order or anything else — write to us and we'll reply within one business day."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    }
  ]
}
{% endschema %}

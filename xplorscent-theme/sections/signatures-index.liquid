{% comment %}
  Editorial index of the signature fragrances: oversized serif rows with a
  floating image reveal on hover (desktop) / inline thumbnails (mobile).
  Each row is fully dynamic — pick a product and its title, image, price and
  URL populate automatically; the manual fields are fallbacks until then.
{% endcomment %}

<signatures-index class="section signatures-index{% if section.settings.background == 'surface' %} color-surface{% endif %}" style="display: block;">
  <div class="container">
    <div class="section__header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div style="position: relative;">
      <ul class="signatures-index__list reveal-group" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_product = block.settings.product
            assign item_title = block.settings.title
            assign item_url = block.settings.link
            if item_product != blank
              assign item_title = item_product.title
              assign item_url = item_product.url
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a
              href="{% if item_url != blank %}{{ item_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
              class="signatures-index__row"
              data-signature-row
            >
              <span class="signatures-index__thumb" aria-hidden="true">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '64px', loading: 'lazy', alt: '' }}
                {%- elsif item_product.featured_media != blank -%}
                  {{ item_product.featured_media | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '64px', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'brand-visual', kind: 'bottle', index: forloop.index0 %}
                {%- endif -%}
              </span>
              <span class="signatures-index__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="signatures-index__title">{{ item_title | escape }}</span>
              <span class="signatures-index__meta">
                {%- if block.settings.notes != blank -%}
                  <span>{{ block.settings.notes | escape }}</span>
                {%- endif -%}
                {%- if item_product != blank -%}
                  <span>{{ item_product.price | money }}</span>
                {%- endif -%}
                {% render 'icon', icon: 'arrow-right', size: 18 %}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <div class="signatures-index__media" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- assign item_product = block.settings.product -%}
          <span class="signatures-index__media-item" data-signature-media>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '350, 700', sizes: '26vw', loading: 'lazy', alt: '' }}
            {%- elsif item_product.featured_media != blank -%}
              {{ item_product.featured_media | image_url: width: 700 | image_tag: widths: '350, 700', sizes: '26vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'brand-visual', kind: 'bottle', index: forloop.index0 %}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</signatures-index>

{% schema %}
{
  "name": "Signatures index",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five signatures"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft beige" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "signature",
      "name": "Signature",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Title, image, price and link populate automatically once selected."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title fallback",
          "default": "The One"
        },
        {
          "type": "text",
          "id": "notes",
          "label": "Note line",
          "default": "Oud · Black pepper · Amber"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link fallback"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Signatures index",
      "blocks": [
        { "type": "signature" },
        { "type": "signature", "settings": { "title": "Sensation", "notes": "Lemon · Lavender · Sandalwood" } },
        { "type": "signature", "settings": { "title": "Victorious", "notes": "Apple · Black currant · Vanilla" } },
        { "type": "signature", "settings": { "title": "Essence of Elegance", "notes": "Iris · Jasmine · Saffron" } },
        { "type": "signature", "settings": { "title": "True Imagination", "notes": "White lily · Rose · Sandalwood" } }
      ]
    }
  ]
}
{% endschema %}

<section class="section{% if section.settings.background == 'surface' %} color-surface{% elsif section.settings.background == 'inverse' %} color-inverse{% endif %}">
  <div class="container container--narrow" style="text-align: {{ section.settings.alignment }};">
    <div class="reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" style="margin-bottom: 2rem;" {{ block.shopify_attributes }}>
              {{ block.settings.heading | escape }}
            </h2>
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              <div style="margin-top: 3.2rem;" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.button_link }}" class="button{% if section.settings.background != 'inverse' %} button--secondary{% endif %}">
                  {{ block.settings.button_label | escape }}
                </a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft beige" },
        { "value": "inverse", "label": "Charcoal" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "The house" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Luxury within reach" },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "h1", "label": "Large" },
            { "value": "h2", "label": "Medium" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We believe a great fragrance shouldn't be reserved for special occasions. Our eaux de parfum are composed with rare oud, bright citrus and refined florals — made to be worn, explored and lived in.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Breadcrumb trail with BreadcrumbList structured data.
  Renders on product and collection pages from Shopify dynamic data.
{% endcomment %}

{%- liquid
  assign show = false
  if request.page_type == 'product' or request.page_type == 'collection'
    assign show = true
  endif
  assign crumb_collection = blank
  if request.page_type == 'product'
    assign crumb_collection = product.collections.first
  elsif request.page_type == 'collection' and collection.handle != 'all'
    assign crumb_collection = collection
  endif
-%}

{%- if show -%}
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    {%- if crumb_collection != blank -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {%- if request.page_type == 'collection' -%}
        <span aria-current="page">{{ crumb_collection.title | escape }}</span>
      {%- else -%}
        <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
      {%- endif -%}
    {%- elsif request.page_type == 'collection' -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title | escape }}</span>
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    {%- endif -%}
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumbs.home' | t | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- if crumb_collection != blank and request.page_type == 'product' -%},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ crumb_collection.title | json }},
          "item": {{ request.origin | append: crumb_collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
        {%- elsif request.page_type == 'product' -%},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
        {%- elsif request.page_type == 'collection' -%},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

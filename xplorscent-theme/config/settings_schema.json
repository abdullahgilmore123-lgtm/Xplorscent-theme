[
  {
    "name": "theme_info",
    "theme_name": "XplorScent",
    "theme_version": "1.0.0",
    "theme_author": "XplorScent Studio",
    "theme_documentation_url": "https://github.com/abdullahgilmore123-lgtm/Xplorscent-theme",
    "theme_support_url": "https://github.com/abdullahgilmore123-lgtm/Xplorscent-theme/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FDFCFA"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (soft beige)",
        "default": "#F4F0E9"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1C1B19"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "info": "Used sparingly: sale prices, star ratings, small highlights.",
        "default": "#8A6D4A"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#1C1B19"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FDFCFA"
      },
      {
        "type": "color",
        "id": "color_inverse",
        "label": "Dark sections (charcoal)",
        "default": "#191714"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "eb_garamond_n4",
        "info": "An editorial serif keeps the boutique feel."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body size scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Space between sections",
        "min": 40,
        "max": 160,
        "step": 8,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "spacing_grid",
        "label": "Grid gap",
        "min": 8,
        "max": 48,
        "step": 4,
        "unit": "px",
        "default": 24
      }
    ]
  },
  {
    "name": "Corners",
    "settings": [
      {
        "type": "range",
        "id": "buttons_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 4
      },
      {
        "type": "range",
        "id": "inputs_radius",
        "label": "Input corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 2
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "portrait", "label": "Portrait (4:5)" },
          { "value": "square", "label": "Square (1:1)" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor",
        "default": false,
        "info": "When off, the product type is shown instead (e.g. Eau de Parfum)."
      },
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "label": "Enable quick add to cart",
        "default": true
      }
    ]
  },
  {
    "name": "Currency format",
    "settings": [
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency codes",
        "info": "e.g. $10.00 USD",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "X (Twitter)"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]
